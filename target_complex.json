# =========================
# Claude structured output
# =========================
class InterfaceInfoAI(BaseModel):
    creation_date: str
    author: str
    interface_id: str
    interface_name: str
    interface_pattern: str
    schedule_driven: str
    execution_cycle: str
    max_records: str
    average_records: str
    split_count: str


class TransmissionAI(BaseModel):
    contact_name: str
    department: str
    contact: str
    integration_technology: str
    server: str
    database: str
    adapter: str
    processing_pattern: str


class MappingItemAI(BaseModel):
    source_path: str
    source_field: str
    source_system: str
    source_table: str
    source_pk: str
    source_type: str
    source_size: str
    source_description: str
    source_remark: str

    target_path: str
    target_field: str
    target_system: str
    target_table: str
    target_pk: str
    target_type: str
    target_size: str
    target_description: str
    target_remark: str

    confidence: int
    reason: str


class ReturnValueAI(BaseModel):
    source_system: str
    source_table: str
    source_pk: str
    source_field: str
    source_type: str
    source_size: str
    source_description: str
    source_remark: str

    target_system: str
    target_table: str
    target_pk: str
    target_field: str
    target_type: str
    target_size: str
    target_description: str
    target_remark: str


class AnalysisResult(BaseModel):
    interface_information: InterfaceInfoAI
    source_transmission: TransmissionAI
    target_transmission: TransmissionAI
    mappings: list[MappingItemAI]
    return_values: list[ReturnValueAI]


# =========================
# JSON parser
# =========================
def flatten_json(data, parent_path=""):
    fields = []

    if not isinstance(data, dict):
        return fields

    for key, value in data.items():
        path = f"{parent_path}.{key}" if parent_path else key

        if isinstance(value, dict):
            fields.extend(flatten_json(value, path))

        elif isinstance(value, list):
            if value and isinstance(value[0], dict):
                fields.extend(flatten_json(value[0], path + "[]"))
            else:
                fields.append({
                    "Path": path,
                    "Field": key,
                    "Type": "array",
                    "Sample": str(value),
                })

        else:
            fields.append({
                "Path": path,
                "Field": key,
                "Type": type(value).__name__,
                "Sample": "" if value is None else str(value),
            })

    return fields


def read_json_file(uploaded_file):
    raw = uploaded_file.getvalue().decode("utf-8-sig")
    return json.loads(raw)


def get_allowed_file_types(interface_type):
    return {
        "JSON": ["json"],
        "PDF": ["pdf"],
        "Swagger": ["json", "yaml", "yml"],
        "EDI": ["edi", "txt"],
        "Open API": ["json", "yaml", "yml"],
        "SOAP": ["xml", "wsdl", "xsd"],
        "Other": None,
    }.get(interface_type)


